# =============================================================================
# metuai compose / host-dev environment template
#
# Two ways to use this file:
#
# A) Host-dev (go run + pnpm dev)
#    From repo root:
#      set -a && source infra/compose/.env.example && set +a
#    Values below point at published localhost ports (55432, 17880, 19000, …).
#
# B) Docker Compose (api + web containers)
#    Copy to infra/compose/.env (Compose auto-loads it for ${VAR} interpolation):
#      cp infra/compose/.env.example infra/compose/.env
#    Then:
#      docker compose -f infra/compose/docker-compose.yml up --build
#    The compose file OVERRIDES DATABASE_URL / LIVEKIT_URL / S3_* to in-network
#    service names (postgres, livekit, minio). Host-dev 127.0.0.1 values here
#    remain correct for `go run` on the host.
#
# JWT secrets are required for compose (fail-closed). Images contain NO default
# EMPLOYEE_JWT_SECRET / GUEST_JWT_SECRET — set them in .env or the shell before up.
# The PoC values below are for local demos only; change them outside throwaway envs.
# =============================================================================

DATABASE_URL=postgres://metuai:metuai@127.0.0.1:55432/metuai?sslmode=disable
EMPLOYEE_JWT_SECRET=dev-employee-secret
GUEST_JWT_SECRET=dev-guest-secret
# 私有转写 ASR（宿主机可达的私有端点；本 compose 不启动 GPU/ASR 容器，无公网 ASR 出站）。
# 未设置时 POST .../transcript/generate 返回 503 ASR_NOT_CONFIGURED。
# ASR_BASE_URL=http://127.0.0.1:9001
# ASR_API_KEY=
# 私有纪要 LLM（OpenAI 兼容基址，如 http://127.0.0.1:11434/v1）。
# 未设置时 POST .../summary/generate 返回 503 AI_NOT_CONFIGURED；不发明待办、不出站公网 LLM。
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=private-llm
# LLM_API_KEY=
# 嘉宾会后访问邮箱验证。未配置时验证接口返回 503，不会给自填邮箱授权。
# SMTP_HOST=smtp.corp.example
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=metuai@corp.example
SMTP_REQUIRE_TLS=true

# LIVEKIT_URL: server-side SDK / egress / kick (host-dev → published port).
# Compose api service overrides this to ws://livekit:7880.
LIVEKIT_URL=ws://127.0.0.1:17880
# LIVEKIT_PUBLIC_URL: returned in livekit-token for browsers only.
# Unset → defaults to LIVEKIT_URL. Compose sets ws://127.0.0.1:5173 so browsers
# use same-origin signaling via web nginx /rtc (never ws://livekit:7880 in tokens).
# Host-dev with `pnpm dev` can use ws://127.0.0.1:5173 (vite /rtc proxy) or keep
# ws://127.0.0.1:17880 when talking to LiveKit on the published host port directly.
# LIVEKIT_PUBLIC_URL=ws://127.0.0.1:5173
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
DEV_ALLOW_EMPLOYEE_WEB=true
IDLE_END_MINUTES=10
UPLOAD_SPOOL_DIR=/tmp/metuai-uploads
# 员工桌面端落盘加密密钥（64 hex = 32 bytes）。不设则用源码开发默认密钥（仅 PoC）。
# METUAI_SPOOL_KEY=
# Host 18080 avoids clashing with other local APIs on 8080.
HTTP_ADDR=:18080
APP_BASE_URL=http://127.0.0.1:5173

# 服务端录制（LiveKit Egress → MinIO）
# 置 true 前请确认 compose 里的 redis + livekit + livekit-egress 都已 up；
# 否则每场会都会开录失败，媒体记为 failed（不会假装 ready，但噪音大）。
EGRESS_ENABLED=false
# 结束会议时等待 Egress 汇报终态的秒数；超时则媒体保持 started 等后续核对。
EGRESS_FINALIZE_SECONDS=8

# MinIO
#
# 坑 1：S3_ENDPOINT 会随 Egress Start 请求下发给 livekit-egress 容器解析。
# 容器里的 127.0.0.1 是它自己，所以 EGRESS_ENABLED=true 时必须：
#   S3_ENDPOINT=http://minio:9000
# （compose 的 api 服务已写死 in-network 覆盖。）
#
# 坑 2：网关在宿主机 `go run` 时 PutObject 要用宿主机可达地址：
#   S3_UPLOAD_ENDPOINT=http://127.0.0.1:19000
# 未设置时回退 S3_ENDPOINT（仅当网关也能解析该地址时可用）。
# compose api 容器内两者都覆盖为 http://minio:9000。
S3_ENDPOINT=http://127.0.0.1:19000
S3_UPLOAD_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=metuai-media
S3_REGION=us-east-1
S3_ACCESS_KEY=metuai
S3_SECRET_KEY=metuai-secret
# 知识检索（默认 MemoryIndex；设 VESPA_URL 时双写 document/v1，ACL 仍走本地副本）
# VESPA_URL=http://127.0.0.1:8080
# schema 草稿：infra/vespa/
# 企业桌面 spool 密钥（64 hex）；网关 GET /v1/device/spool-key 下发
# METUAI_SPOOL_KEY=
